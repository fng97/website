.{
    .name = "Mind-Blowing Vegan Mac and Cheese",
    .source = "https://rainbowplantlife.com/crispy-baked-vegan-mac-and-cheese",
    .servings = 8,
    .prep_time = 20,
    .cook_time = 35,
    .ingredients = .{
        .{
            .ingredient = "carrot",
            .amount = .{ .quantity = 1 },
            .note = "small, ~50g",
        },
        .{
            .ingredient = "maris piper potatoes",
            .amount = .{ .quantity = 227, .unit = .g },
        },
        .{
            .ingredient = "raw cashews",
            .amount = .{ .quantity = 115, .unit = .g },
        },
        .{
            .ingredient = "water",
            .amount = .{ .quantity = 480, .unit = .mL },
        },
        .{
            .ingredient = "nutritional yeast",
            .amount = .{ .quantity = 50, .unit = .g },
        },
        .{
            .ingredient = "garlic powder",
            .amount = .{ .quantity = 1, .unit = .tsp },
        },
        .{
            .ingredient = "onion powder",
            .amount = .{ .quantity = 0.5, .unit = .tsp },
        },
        .{
            .ingredient = "smoked paprika",
            .amount = .{ .quantity = 0.5, .unit = .tsp },
        },
        .{
            .ingredient = "cayenne pepper",
            .amount = .{ .quantity = 0.125, .unit = .tsp },
        },
        .{
            .ingredient = "turmeric",
            .amount = .{ .quantity = 0.125, .unit = .tsp },
            .note = "for color",
        },
        .{
            .ingredient = "soy sauce",
            .amount = .{ .quantity = 3, .unit = .tsp },
        },
        .{
            .ingredient = "apple cider vinegar",
            .amount = .{ .quantity = 1, .unit = .tbsp },
        },
        .{
            .ingredient = "extra virgin olive oil",
            .amount = .{ .quantity = 35, .unit = .g },
        },
        .{
            .ingredient = "salt and pepper",
            .note = "to taste",
        },
        .{
            .ingredient = "vegan butter",
            .amount = .{ .quantity = 35, .unit = .g },
        },
        .{
            .ingredient = "panko breadcrumbs",
            .amount = .{ .quantity = 65, .unit = .g },
        },
        .{
            .ingredient = "nutritional yeast for topping",
            .amount = .{ .quantity = 5, .unit = .g },
            .note = "1 tbsp",
        },
        .{
            .ingredient = "smoked paprika for topping",
            .amount = .{ .quantity = 0.125, .unit = .tsp },
        },
        .{
            .ingredient = "elbow macaroni",
            .amount = .{ .quantity = 340, .unit = .g },
        },
        .{
            .ingredient = "vegan butter",
            .amount = .{ .quantity = 21, .unit = .g },
        },
    },
    .instructions = .{
        \\Bring a large saucepan of water to a boil for the macaroni.
        ,
        \\Peel the carrot, then slice into 1/4 inch coins (6 mm). Peel the potatoes, then cut into
        \\1 inch chunks (2.5 cm).
        ,
        \\Add carrots, potatoes, and cashews to a medium saucepan and cover with enough water to
        \\submerge. Bring to a boil and boil for 15 minutes, or until potatoes and carrots are soft
        \\and easily smash with a fork. Drain and let rest until no longer hot. Pick out the potato
        \\pieces and keep separate from the cashews/carrots.
        ,
        \\While the cashews/veg boil, make the Crispy Topping. Add 2 1/2 TBSP (35g) butter to a
        \\small bowl and melt in the microwave. Mix in the panko, 1 TBSP (5g) nutritional yeast,
        \\1/8 tsp smoked paprika, and 2 pinches of salt, stirring well until the butter is evenly
        \\distributed and there are no clumps. Set aside.
        ,
        \\Cook the pasta. When the water is boiling, salt it generously. Cook the macaroni 1 minute
        \\less than the time indicated on the box, or until just shy of al dente.
        \\
        \\Drain the pasta but do not rinse. Return the pasta to its pot, and toss with 1 1/2 TBSP
        \\(21g) vegan butter (or olive oil). Set aside.
        ,
        \\Preheat the oven to 375F/190C. Lightly grease a 3-quart / 3L (13"x9") baking dish with
        \\softened/melted butter or olive oil.
        ,
        \\Make the cheese sauce. In a high-powered blender, combine the 2 cups (480 mL) water,
        \\nutritional yeast, garlic powder, onion powder, smoked paprika, cayenne, turmeric, 3
        \\teaspoons soy sauce, apple cider vinegar, olive oil, several twists of black pepper, and 1
        \\1/2 teaspoons kosher salt. Add the boiled carrots and cashews (but not the potatoes).
        \\
        \\Blend on high until completely smooth and creamy and all cashew bits have been pulverized,
        \\scraping down the sides as you go.
        ,
        \\Now add the boiled potatoes and blend on medium-low for 15 to 30 seconds, just until
        \\combined and pureed. NOTE: The sauce will be looser than seems right, like the
        \\consistency of a smoothie.
        ,
        \\Taste the sauce, adding more pickle brine for zing/tang, more nutritional yeast for
        \\cheesiness, or more soy sauce for savory saltiness (I usually use 4 teaspoons total).
        \\If adding any additional ingredients, blend on medium-low just to combine.
        ,
        \\Pour the cheese sauce into the pot of cooked macaroni, tossing well. NOTE: It will feel
        \\like too much sauce now, but it thickens as it bakes.
        ,
        \\Transfer the mac and cheese to the prepared baking dish and sprinkle the Crispy Topping
        \\evenly over the top. Bake for 20 minutes or until the topping is golden brown.
        \\
        \\Cool for 10 to 20 minutes to help set up, then slice and serve.
        ,
    },
}
